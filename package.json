{
  "name": "genius-support-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fundação arquitetural do Genius Support OS, com foco em multi-tenant, auditoria, contratos e backend como source of truth.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "extract:octadesk": "node raw_knowledge/octadesk_export/export-octadesk-kb.mjs",
    "supabase:bootstrap:first-admin": "node supabase/bootstrap/bootstrap-first-platform-admin.mjs",
    "supabase:wait:ready": "node scripts/ci/wait-for-supabase-ready.mjs",
    "supabase:db:reset:raw": "supabase db reset --local --yes",
    "supabase:db:reset": "node scripts/ci/run-supabase-db-reset.mjs",
    "supabase:test:db": "supabase test db --local",
    "supabase:lint:db": "supabase db lint --local",
    "supabase:verify": "node scripts/ci/run-supabase-verify.mjs",
    "supabase:qa:local-admin-fixture": "node supabase/qa/create-local-admin-fixture.mjs",
    "supabase:qa:local-dashboard-viewer": "node supabase/qa/create-local-dashboard-viewer-fixture.mjs",
    "supabase:qa:local-functional-fixture": "node supabase/qa/create-local-functional-fixture.mjs",
    "supabase:qa:local-cs-ops-fixture": "node supabase/qa/create-local-cs-ops-fixture.mjs",
    "local:qa:reset": "node scripts/local-qa/reset.mjs",
    "local:qa:hydrate": "node scripts/local-qa/hydrate.mjs",
    "local:qa:verify": "node scripts/local-qa/verify.mjs",
    "local:qa:smoke": "node scripts/local-qa/browser-smoke.mjs",
    "local:qa:smoke:auth": "node scripts/local-qa/smoke.mjs",
    "local:qa:writes": "node scripts/local-qa/ui-writes.mjs",
    "local:qa:scenario": "node scripts/local-qa/scenario.mjs",
    "knowledge:curation:backlog": "node scripts/knowledge/generate-curation-backlog.mjs",
    "knowledge:import:octadesk:local": "node scripts/knowledge/import-octadesk-drafts.mjs --local",
    "knowledge:import:octadesk:pilot": "node scripts/knowledge/import-octadesk-drafts.mjs --local --space-slug genius --allowlist docs/reports/OCTADESK_PUBLIC_HELP_PILOT_ALLOWLIST.json",
    "knowledge:import:octadesk:pilot:apply": "node scripts/knowledge/import-octadesk-drafts.mjs --local --space-slug genius --allowlist docs/reports/OCTADESK_PUBLIC_HELP_PILOT_ALLOWLIST.json --apply",
    "knowledge:review:advisories:local": "node scripts/knowledge/sync-review-advisories.mjs --local",
    "knowledge:review:advisories:pilot": "node scripts/knowledge/sync-review-advisories.mjs --local --space-slug genius --allowlist docs/reports/OCTADESK_PUBLIC_HELP_PILOT_ALLOWLIST.json",
    "knowledge:review:advisories:pilot:apply": "node scripts/knowledge/sync-review-advisories.mjs --local --space-slug genius --allowlist docs/reports/OCTADESK_PUBLIC_HELP_PILOT_ALLOWLIST.json --apply",
    "knowledge:verify:octadesk:space-aware": "node scripts/ci/verify-octadesk-import-space-aware.mjs",
    "documentation:validate:internal-docs": "node scripts/documentation/validate-internal-documents.mjs",
    "repository:check-root": "node scripts/ci/check-root-artifacts.mjs",
    "security:audit:prod": "node scripts/ci/check-dependency-advisories.mjs",
    "supabase:qa:local-release-preview": "node supabase/qa/local-release-preview.mjs --enable",
    "supabase:qa:local-release-preview:status": "node supabase/qa/local-release-preview.mjs --status",
    "supabase:qa:local-release-preview:disable": "node supabase/qa/local-release-preview.mjs --disable",
    "documentation:sync:internal-docs": "node scripts/documentation/sync-internal-documents.mjs",
    "documentation:sync:internal-docs:apply": "node scripts/documentation/sync-internal-documents.mjs --apply",
    "documentation:sync:internal-docs:local": "node scripts/documentation/sync-internal-documents-local.mjs",
    "lint:fix": "npm run lint --workspaces --if-present -- --fix",
    "dev": "node scripts/dev/run-web-dev.mjs",
    "build": "npm run build --workspace @genius-support-os/web",
    "test": "npm run test:focused",
    "test:focused": "node scripts/run-focused-tests.mjs",
    "test:all": "node --test tests/**/*.test.mjs",
    "test:watch": "node --watch scripts/run-focused-tests.mjs",
    "quality:changed": "node .agents/skills/genius-code-quality/scripts/run-quality-gate.mjs changed",
    "quality:staged": "node .agents/skills/genius-code-quality/scripts/run-quality-gate.mjs staged",
    "quality:module": "node .agents/skills/genius-code-quality/scripts/run-quality-gate.mjs module",
    "quality:all": "node .agents/skills/genius-code-quality/scripts/run-quality-gate.mjs all",
    "docs:audit": "node .agents/skills/genius-documentation-governance/scripts/run-documentation-audit.mjs report",
    "docs:audit:staged": "node .agents/skills/genius-documentation-governance/scripts/run-documentation-audit.mjs staged",
    "docs:audit:apply": "node .agents/skills/genius-documentation-governance/scripts/run-documentation-audit.mjs apply",
    "docs:validate": "npm run documentation:validate:internal-docs",
    "contracts:typecheck": "npm run typecheck --workspace @genius-support-os/contracts",
    "supabase:start": "supabase start",
    "supabase:functions:serve": "supabase functions serve",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:diff": "supabase db diff -f",
    "supabase:test": "supabase test db",
    "supabase:test:file": "node scripts/run-pgtap-file.mjs",
    "supabase:qa:seed-cs-ops": "node supabase/qa/create-local-cs-ops-fixture.mjs",
    "supabase:qa:local-support-fixture": "node scripts/local-qa/create-local-support-queue-fixture.mjs",
    "local:qa:assert-supabase": "node scripts/local-qa/assert-local-supabase.mjs",
    "local:qa:commercial-pipeline-audit": "node scripts/local-qa/commercial-pipeline-audit.mjs",
    "local:qa:cs-b2b-ux-data-audit": "node scripts/local-qa/cs-b2b-ux-data-audit.mjs",
    "local:qa:help-center-release-smoke": "node scripts/local-qa/help-center-release-smoke.mjs",
    "local:qa:settings-sources-delta-audit": "node scripts/local-qa/settings-sources-delta-audit.mjs",
    "local:qa:settings-ux-friction-audit": "node scripts/local-qa/settings-ux-friction-audit.mjs",
    "local:qa:settings-control-plane-v2-preview": "node scripts/local-qa/settings-control-plane-v2-preview.mjs",
    "local:qa:hubspot-discovery": "node scripts/local-qa/hubspot-discovery.mjs",
    "local:qa:hubspot-error-sanitization-smoke": "node scripts/local-qa/hubspot-error-sanitization-smoke.mjs",
    "local:qa:hubspot-catalog-service-identity-smoke": "node scripts/local-qa/hubspot-catalog-service-identity-smoke.mjs",
    "local:qa:dashboard-reconcile-hubspot-leases-smoke": "node scripts/local-qa/dashboard-reconcile-hubspot-leases-smoke.mjs",
    "local:qa:dashboard-runtime-v3-preview": "node scripts/local-qa/dashboard-runtime-v3-preview.mjs",
    "local:qa:dashboard-sync-loading-smoke": "node scripts/local-qa/dashboard-sync-loading-smoke.mjs",
    "local:qa:dashboard-visual-system-v1-preview": "node scripts/local-qa/dashboard-visual-system-v1-preview.mjs",
    "local:qa:dashboard-visual-density-v1-1-preview": "node scripts/local-qa/dashboard-visual-density-v1-1-preview.mjs",
    "local:qa:high-density-ui-rebuild-preview": "node scripts/local-qa/high-density-ui-rebuild-preview.mjs",
    "local:qa:admin-configuration-visual-v1-preview": "node scripts/local-qa/admin-configuration-visual-v1-preview.mjs",
    "local:qa:confi-one-global-audit": "node scripts/local-qa/verify-confi-one-v1-global-audit-qa.mjs",
    "local:qa:secret-scan": "node scripts/local-qa/secret-scan.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "web:typecheck": "npm run typecheck --workspace @genius-support-os/web",
    "web:build": "npm run build --workspace @genius-support-os/web"
  },
  "devDependencies": {
    "playwright": "^1.61.0",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "supabase": "^2.105.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
