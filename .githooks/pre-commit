#!/bin/sh
set -eu

if [ "${GENIUS_QUALITY_SKIP:-0}" = "1" ]; then
  if [ -z "${GENIUS_QUALITY_SKIP_REASON:-}" ]; then
    echo "GENIUS_QUALITY_SKIP exige GENIUS_QUALITY_SKIP_REASON." >&2
    exit 1
  fi
  echo "Genius Code Quality pre-commit ignorado: ${GENIUS_QUALITY_SKIP_REASON}" >&2
  exit 0
fi

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "$staged_files" ]; then
  exit 0
fi

npm run quality:staged
